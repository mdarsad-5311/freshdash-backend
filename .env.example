# =============================================================================
# FreshDash Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual secrets.
# NEVER commit the active .env file to version control.
# =============================================================================

# Django Security
# Generate using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-your-strong-random-django-secret-key

# JWT Token Security (Must be separate from SECRET_KEY in production)
JWT_SECRET_KEY=replace-with-your-strong-random-jwt-secret-key

# Debug Mode (Must be False in production)
DEBUG=False

# Allowed Hosts (Comma-separated hostnames or IP addresses)
# e.g., api.freshdash.com,127.0.0.1
ALLOWED_HOSTS=api.freshdash.com,127.0.0.1,localhost

# CSRF Trusted Origins (Comma-separated list of schemes + domains)
# e.g., https://api.freshdash.com,https://freshdash.com
CSRF_TRUSTED_ORIGINS=https://api.freshdash.com

# CORS Configuration
# Set to False in production and provide explicit CORS_ALLOWED_ORIGINS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://freshdash.com,http://localhost:8081

# SQLite3 Persistent Storage Path (Optional, defaults to project root db.sqlite3)
# In containerized/VPS environments, point to your mounted persistent volume:
# SQLITE_DB_PATH=/data/freshdash/db.sqlite3
SQLITE_DB_PATH=

# Media Files Persistent Root Directory (Optional, defaults to BASE_DIR / media)
# MEDIA_ROOT=/data/freshdash/media
MEDIA_ROOT=

# Pagination
PAGE_SIZE=20

# Logging Level (INFO, WARNING, ERROR, DEBUG)
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING
